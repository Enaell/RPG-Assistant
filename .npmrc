# pnpm configuration
# https://pnpm.io/npmrc

# Hoist all dependencies to the root node_modules so VS Code's TypeScript
# Language Server (which runs on the Windows host) can resolve modules without
# having to follow WSL-created symlinks.
shamefully-hoist=true

# Allow better-sqlite3 to run its native build script (compiles the SQLite addon)
onlyBuiltDependencies[]=better-sqlite3
