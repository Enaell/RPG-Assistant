# ─── Discord Bot ────────────────────────────────────────────
# https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_GUILD_ID=your_guild_id_here

# ─── STT — Voxtral / Mistral API ────────────────────────────
# Requis pour AUDIO_OUTPUT_MODE=stt ET pour /session transcribe
MISTRAL_API_KEY=your_mistral_api_key_here

# Modèle pour l'endpoint HTTP POST /v1/audio/transcriptions
#   voxtral-mini-latest                   → batch (recommandé pour WAV enregistrés)
#   voxtral-mini-transcribe-realtime-2602 → optimisé temps réel (Phase 2 WebSocket)
STT_MODEL=voxtral-mini-latest

# Hint de langue ISO 639-1 (fr, en…) — améliore la précision. Laisser vide = auto-détection
STT_LANGUAGE=fr

# ─── Audio Output ──────────────────────────────────────────
# 'local' : enregistre les .wav sur disque (dev / debug UNIQUEMENT)
# 'stt'   : envoie vers l'API Voxtral Mistral en temps réel (Phase 1+)
AUDIO_OUTPUT_MODE=local

# Répertoire de destination des .wav quand AUDIO_OUTPUT_MODE=local
# Ces fichiers sont ensuite utilisables avec /session transcribe
RECORDINGS_DIR=./recordings

# ─── Database ───────────────────────────────────────────────
# Fichier SQLite — sessions + lignes de transcript
# En Docker : monté via le volume db-data → /app/data/rpg-assistant.db
DB_PATH=./data/rpg-assistant.db

# ─── Environment ────────────────────────────────────────────
NODE_ENV=development
