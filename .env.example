# ─── Discord Bot ────────────────────────────────────────────
# https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_BOT_AUTHORIZATION_URI=

# Guild (server) ID — used to register slash commands instantly during dev
# In production, remove this to use global commands (takes ~1h to propagate)
DISCORD_GUILD_ID=

# ─── STT — Voxtral / Mistral API (Phase 1) ──────────────────
# Requis si AUDIO_OUTPUT_MODE=stt, et pour /session transcribe quel que soit le
# mode. Validé par Zod au démarrage (apps/discord-bot/src/index.ts) : le bot
# refuse de démarrer si AUDIO_OUTPUT_MODE=stt et cette clé est absente.
MISTRAL_API_KEY=

# ─── Audio Output ──────────────────────────────────────────
# 'local' : enregistre les .wav sur disque (développement / debug UNIQUEMENT)
# 'stt'   : envoie chaque utterance (segment court) à l'endpoint batch HTTP
#           Voxtral dès qu'elle est captée (packages/stt-client) — ce n'est PAS
#           un flux streaming/WebSocket temps réel, juste des appels HTTP fréquents.
AUDIO_OUTPUT_MODE=local
# Répertoire de destination quand AUDIO_OUTPUT_MODE=local
RECORDINGS_DIR=./recordings

# ─── STT — Voxtral / Mistral API ───────────────────────────
# Modèle utilisé par l'endpoint HTTP POST /v1/audio/transcriptions (batch)
#   voxtral-mini-latest                    → recommandé pour les WAV bufferisés
# Ne pas utiliser voxtral-mini-transcribe-realtime-2602 ici : ce modèle est
# réservé à l'API realtime/WebSocket, qui n'est pas implémentée dans ce client.
# Le schéma Zod (index.ts) rejette au démarrage tout STT_MODEL contenant "realtime".
STT_MODEL=voxtral-mini-latest
# Langue audio (BCP-47) — améliore la précision si connue. Laisser vide = auto-détection
STT_LANGUAGE=fr

# ─── Environment ────────────────────────────────────────────
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────
# Chemin vers le fichier SQLite (relatif au cwd ou absolu)
# En Docker : monté via le volume db-data → /app/data/rpg-assistant.db
DB_PATH=./data/rpg-assistant.db
